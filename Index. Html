<script>

function toggleDark(){

document.body.classList.toggle("dark");

document.getElementById("themeBtn").textContent =
document.body.classList.contains("dark")
? "☀️"
: "🌙";

}


function toggleMenu(){

document.getElementById("nav").classList.toggle("open");

}


function toggleBox(id){

document.getElementById(id).classList.toggle("show");

}


function countWords(){

const text =
document.getElementById("wordText").value;

const words =
text.trim()
? text.trim().split(/\s+/).length
: 0;

document.getElementById("wordResult").textContent =
"Words: " + words +
" | Characters: " + text.length;

}


function makePassword(){

const chars =
"ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%";

let p = "";

for(let i=0;i<12;i++){

p += chars[
Math.floor(Math.random()*chars.length)
];

}

document.getElementById("pass").value = p;

}


async function copyPass(){

const p =
document.getElementById("pass").value;

if(!p){

makePassword();

}

try{

await navigator.clipboard.writeText(
document.getElementById("pass").value
);

showToast("Password copied!");

}catch(e){

showToast("Copy failed.");

}

}


function calcPercent(){

const n =
parseFloat(document.getElementById("num").value);

const p =
parseFloat(document.getElementById("pct").value);

document.getElementById("pctResult").textContent =

Number.isFinite(n) &&
Number.isFinite(p)

?

p + "% of " +
n +
" = " +
(n*p/100)

:

"Enter both values.";

}


function calcAge(){

const value =
document.getElementById("dob").value;

if(!value){

document.getElementById("ageResult").textContent =
"Select your birth date.";

return;

}

const dob =
new Date(value);

const today =
new Date();

let age =
today.getFullYear() -
dob.getFullYear();

const m =
today.getMonth() -
dob.getMonth();

if(
m < 0 ||
(m === 0 &&
today.getDate() < dob.getDate())
){

age--;

}

document.getElementById("ageResult").textContent =
"Your age: " + age + " years";

}


function add(){

const a =
parseFloat(document.getElementById("a").value);

const b =
parseFloat(document.getElementById("b").value);

document.getElementById("calcResult").textContent =

Number.isFinite(a) &&
Number.isFinite(b)

?

"Result: " + (a+b)

:

"Enter both numbers.";

}


function searchTools(){

const q =
document.getElementById("search")
.value
.toLowerCase();

document.querySelectorAll(".tool")
.forEach(card => {

card.style.display =
card.innerText
.toLowerCase()
.includes(q)
? "block"
: "none";

});

}


/* 5 AD FOLDERS */

let selectedAdFolder = 0;

function openAdFolder(number){

selectedAdFolder = number;

document.getElementById("adModal").style.display = "flex";

}


function closeAdFolder(){

document.getElementById("adModal").style.display = "none";

}


function continueAdFolder(){

closeAdFolder();

showToast(
"Ad " + selectedAdFolder + " selected!"
);

}


function showToast(msg){

const t =
document.getElementById("toast");

t.textContent = msg;

t.classList.add("show");

setTimeout(
() => t.classList.remove("show"),
1800
);

}


window.addEventListener(
"scroll",
() => {

document.getElementById("topBtn").style.display =
scrollY > 350
? "block"
: "none";

}
);

</script>

